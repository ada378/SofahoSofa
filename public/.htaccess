Options -MultiViews
RewriteEngine On
RewriteBase /

# Serve existing files & directories directly (JS, CSS, images, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Send ALL other requests to index.html (React Router handles routing)
RewriteRule ^ /index.html [L]
